# embedded = falkordblite (no server needed, used by tests and the cloud session)
# remote   = a FalkorDB server (docker or FalkorDB Cloud)
RIPPLE_DB_MODE=embedded
RIPPLE_DB_PATH=var/ripple.db
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Agents run in deterministic "scripted" mode when this is empty.
ANTHROPIC_API_KEY=
RIPPLE_MODEL=claude-opus-5-5

# Embeddings: "hash" (local, deterministic, 384-d) works offline.
# "openai" uses text-embedding-3-small (1536-d) and needs OPENAI_API_KEY.
RIPPLE_EMBEDDINGS=hash
OPENAI_API_KEY=

# Graphiti temporal memory (optional; needs an LLM key). Off by default.
RIPPLE_GRAPHITI=0

API_CORS_ORIGINS=http://localhost:5173
