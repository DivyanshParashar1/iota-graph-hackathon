# embedded = falkordblite (no server needed, used by tests and the cloud session)
# remote   = a FalkorDB server (docker compose or FalkorDB Cloud)
RIPPLE_DB_MODE=embedded
RIPPLE_DB_PATH=var/ripple.db
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# docker compose starts FalkorDB with --requirepass FALKORDB_PASSWORD (required there); the user is "default".
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
# FalkorDB Browser (:3000) session secrets, required once the DB has a password: openssl rand -hex 32
FALKORDB_BROWSER_ENCRYPTION_KEY=
FALKORDB_BROWSER_NEXTAUTH_SECRET=

# LLM. There is no scripted fallback in v2: with no provider, an agent turn fails and says so.
# claude_code = Claude Code on this machine's login, no API key (`claude -p`, its own tools off). The default.
# openrouter  = OPENROUTER_API_KEY + OPENROUTER_MODEL.
# anthropic   = ANTHROPIC_API_KEY + RIPPLE_MODEL.
# auto        = claude_code if the CLI is installed, else openrouter, else anthropic.
RIPPLE_LLM_PROVIDER=claude_code
RIPPLE_LLM_EFFORT=medium
RIPPLE_LLM_MAX_TOKENS=16000
CLAUDE_CODE_MODEL=opus
# Empty = run the `claude` CLI directly. docker compose points the container at the host bridge
# (python -m ripple.claude_code_bridge) instead, since Claude Code runs on the host login; the token is
# optional and shared by both sides.
CLAUDE_CODE_BRIDGE_URL=
CLAUDE_CODE_BRIDGE_TOKEN=
CLAUDE_CODE_TIMEOUT=600
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
ANTHROPIC_API_KEY=
RIPPLE_MODEL=claude-opus-5-5

# Onboarding
# The file-side mirror of each tenant: uploads/ and the exported expert prompts experts/*.md.
RIPPLE_TENANTS_DIR=tenants
RIPPLE_MAX_UPLOAD_MB=25
# Set to capture every LLM request and response as JSON (the live suite points this at artifacts/llm_runs/).
RIPPLE_LLM_LOG_DIR=

API_CORS_ORIGINS=http://localhost:5173
