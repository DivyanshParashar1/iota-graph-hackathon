# embedded = falkordblite (no server needed, used by tests and the cloud session)
# remote   = a FalkorDB server (docker compose or FalkorDB Cloud)
RIPPLE_DB_MODE=embedded
RIPPLE_DB_PATH=var/ripple.db
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# docker compose starts FalkorDB with --requirepass FALKORDB_PASSWORD (required there); the user is "default".
FALKORDB_USERNAME=default
FALKORDB_PASSWORD=
# FalkorDB Browser (:3000) session secrets, required once the DB has a password: openssl rand -hex 32
FALKORDB_BROWSER_ENCRYPTION_KEY=
FALKORDB_BROWSER_NEXTAUTH_SECRET=

# LLM: agents run in deterministic "scripted" mode when no provider is available.
# auto        = OpenRouter if OPENROUTER_API_KEY is set, else Anthropic if ANTHROPIC_API_KEY is set.
# claude_code = Claude Code on this machine's login, no API key (`claude -p`, its own tools off).
RIPPLE_LLM_PROVIDER=auto
CLAUDE_CODE_MODEL=opus
# Empty = run the `claude` CLI directly (API on the host). docker compose points the container at the host
# bridge (python -m ripple.claude_code_bridge) instead; the token is optional and shared by both sides.
CLAUDE_CODE_BRIDGE_URL=
CLAUDE_CODE_BRIDGE_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-opus-5.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Direct Anthropic API (optional alternative)
ANTHROPIC_API_KEY=
RIPPLE_MODEL=claude-opus-5-5

# Embeddings: "hash" (local, deterministic, 384-d) works offline. Claude (and so Claude Code) has no embedding
# model: with RIPPLE_LLM_PROVIDER=claude_code keep "hash" for a setup with no API keys at all.
# "openrouter" uses OPENROUTER_EMBED_MODEL via OpenRouter (openai/text-embedding-3-small is 1536-d).
# RIPPLE_EMBED_DIM is optional (probed from the model when empty). Changing the embedder changes the vector
# index dimension: rebuild the graphs afterwards (python -m ripple.ingest.build, or a fresh compose volume).
RIPPLE_EMBEDDINGS=hash
OPENROUTER_EMBED_MODEL=openai/text-embedding-3-small
RIPPLE_EMBED_DIM=
# "openai" (direct OpenAI API, text-embedding-3-small) is still supported
OPENAI_API_KEY=

# Graphiti temporal memory (optional; needs an LLM key). Off by default.
RIPPLE_GRAPHITI=0

API_CORS_ORIGINS=http://localhost:5173
