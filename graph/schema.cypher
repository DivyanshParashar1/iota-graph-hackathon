// Ripple schema. One statement per line. `// graph: ops|mem` switches the target graph.
// {dim} is replaced with the embedder dimension (384 for the local hash embedder).
// graph: ops
CREATE INDEX FOR (n:Supplier) ON (n.id)
CREATE INDEX FOR (n:Part) ON (n.id)
CREATE INDEX FOR (n:Product) ON (n.id)
CREATE INDEX FOR (n:Plant) ON (n.id)
CREATE INDEX FOR (n:Port) ON (n.id)
CREATE INDEX FOR (n:Lane) ON (n.id)
CREATE INDEX FOR (n:Lane) ON (n.carrier)
CREATE INDEX FOR (n:Order) ON (n.id)
CREATE INDEX FOR (n:Order) ON (n.status)
CREATE INDEX FOR (n:OrderLine) ON (n.id)
CREATE INDEX FOR (n:Customer) ON (n.id)
CREATE INDEX FOR (n:Market) ON (n.id)
CREATE INDEX FOR (n:Region) ON (n.id)
CREATE INDEX FOR (n:Disruption) ON (n.id)
CREATE INDEX FOR (n:Incident) ON (n.id)
CREATE INDEX FOR (n:Action) ON (n.id)
CREATE INDEX FOR (n:Action) ON (n.status)
CREATE INDEX FOR (n:Agent) ON (n.name)
CREATE INDEX FOR (n:ToolCall) ON (n.id)
CREATE INDEX FOR (n:User) ON (n.id)
CREATE INDEX FOR (n:Employee) ON (n.id)
CREATE INDEX FOR (n:Team) ON (n.id)
CREATE INDEX FOR (n:Contract) ON (n.id)
CREATE INDEX FOR (n:Contract) ON (n.supplier_id)
CREATE INDEX FOR (n:Document) ON (n.id)
CREATE INDEX FOR (n:Chunk) ON (n.id)
CREATE INDEX FOR (n:Thread) ON (n.id)
CREATE INDEX FOR (n:ChatMessage) ON (n.id)
CREATE INDEX FOR (n:Decision) ON (n.id)
CREATE VECTOR INDEX FOR (n:Chunk) ON (n.embedding) OPTIONS {dimension: {dim}, similarityFunction: 'cosine'}
CREATE VECTOR INDEX FOR (n:ChatMessage) ON (n.embedding) OPTIONS {dimension: {dim}, similarityFunction: 'cosine'}
CREATE FULLTEXT INDEX FOR (n:Document) ON (n.title)
// graph: mem
CREATE INDEX FOR (n:Episode) ON (n.id)
CREATE INDEX FOR (n:Playbook) ON (n.id)
CREATE INDEX FOR (n:Playbook) ON (n.disruption_type)
CREATE INDEX FOR (n:Fact) ON (n.id)
CREATE INDEX FOR (n:Fact) ON (n.subject_id)
CREATE INDEX FOR (n:User) ON (n.id)
CREATE INDEX FOR (n:Conversation) ON (n.id)
CREATE INDEX FOR (n:ConvMessage) ON (n.id)
CREATE VECTOR INDEX FOR (n:Episode) ON (n.embedding) OPTIONS {dimension: {dim}, similarityFunction: 'cosine'}
