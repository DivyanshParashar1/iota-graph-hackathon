{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "if [ \"$CLAUDE_CODE_REMOTE\" = \"true\" ] && [ ! -x \"$CLAUDE_PROJECT_DIR/.venv/bin/python\" ]; then bash \"$CLAUDE_PROJECT_DIR/scripts/setup_env.sh\" 2>&1 | tail -20; fi",
            "timeout": 600
          }
        ]
      }
    ]
  }
}
